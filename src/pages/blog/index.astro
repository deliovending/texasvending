---
import BaseLayout from '../../layouts/BaseLayout.astro';
import PostCard from '../../components/PostCard.astro';
import { getPublishedPosts } from '../../lib/blog';

const posts = await getPublishedPosts();
---

<BaseLayout
	title="Blog"
	description="Break room ideas, vending tips, and news from Texas Vending for businesses across Dallas–Fort Worth."
>
	<section class="bg-ink text-white">
		<div class="mx-auto max-w-6xl px-4 py-16 md:py-20">
			<p class="eyebrow !text-white/60">Texas Vending blog</p>
			<h1 class="mt-3 text-5xl uppercase md:text-6xl">Break Room Ideas &amp; Vending Tips</h1>
			<p class="mt-4 max-w-2xl text-lg text-white/80">
				Practical advice for DFW offices, warehouses, and facilities that want a better break room.
			</p>
		</div>
	</section>

	<section class="bg-slate-100 py-16 md:py-20">
		<div class="mx-auto max-w-6xl px-4">
			{
				posts.length > 0 ? (
					<ul class="grid gap-8 sm:grid-cols-2 lg:grid-cols-3">
						{posts.map((post) => (
							<li>
								<PostCard post={post} />
							</li>
						))}
					</ul>
				) : (
					<p class="text-center text-lg text-slate-600">New posts are coming soon.</p>
				)
			}
		</div>
	</section>
</BaseLayout>
