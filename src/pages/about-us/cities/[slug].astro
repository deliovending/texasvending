---
import type { ImageMetadata } from 'astro';
import ServiceLayout from '../../../layouts/ServiceLayout.astro';
import MediaSection from '../../../components/MediaSection.astro';
import PhotoPair from '../../../components/PhotoPair.astro';
import { cities, cityBySlug, cityHref, cityPhotoAlt, industryInfo, type City } from '../../../data/cities';

export function getStaticPaths() {
	// Alliance has its own page at /alliance-texas-vending-services/
	return cities.filter((city) => !city.href).map((city) => ({ params: { slug: city.slug }, props: { city } }));
}

const { city } = Astro.props as { city: City };

const photoFiles = import.meta.glob<ImageMetadata>('../../../assets/cities/*', { eager: true, import: 'default' });
const photo = (file: string) => ({ image: photoFiles[`../../../assets/cities/${file}`], alt: cityPhotoAlt[file] });
const [hero, first, second, pairLeft, pairRight, last] = city.photos.map(photo);

// Area pages cover several towns and are named for the area, not just the destination city
const townNames = city.towns?.map((town) => town.name);
const areaName = city.towns ? `the ${city.name} Area` : city.name;
const title = city.towns ? `Vending Services in the ${city.name} Area` : `Vending Services in ${city.name}, TX`;
const description = townNames
	? `Free vending, micro markets, and smart coolers for ${townNames.join(', ')}. Cashless, no contract, 24-hour response.`
	: `Free vending machines, micro markets, and smart coolers for ${city.name}, TX businesses. Cashless, no long-term contract, 24-hour response.`;
const placeList = townNames ? townNames.join(', ') : city.name;

const nearbyCities = city.nearby.map(cityBySlug).filter((nearby): nearby is City => Boolean(nearby));
// "Wikipedia: Plano, Texas" for Wikipedia links, the site name otherwise; repeats get a number
const sourceLabels = (() => {
	const seen = new Map<string, number>();
	return city.sources.map((url) => {
		const { hostname, pathname } = new URL(url);
		const base = hostname.endsWith('wikipedia.org')
			? `Wikipedia: ${decodeURIComponent(pathname.split('/').pop() ?? '').replace(/_/g, ' ')}`
			: hostname.replace(/^www\./, '');
		const count = (seen.get(base) ?? 0) + 1;
		seen.set(base, count);
		return count > 1 ? `${base} (${count})` : base;
	});
})();

const faqs = [
	{
		question: `Do you offer free vending machines in ${areaName}?`,
		answer: `Yes. Texas Vending places vending machines, micro markets, and AI smart coolers at no cost to ${city.name}-area locations with at least 50 people in total foot traffic, counting employees and visitors.`,
	},
	...(city.faq ? [city.faq] : []),
	{
		question: `Do you serve cities near ${city.name}?`,
		answer: `Yes. We also serve ${nearbyCities.map((nearby) => nearby.name).join(', ')}, and the rest of Dallas–Fort Worth.`,
	},
	{
		question: `How fast do you respond to service calls in ${areaName}?`,
		answer: 'Local technicians respond to reported service issues within 24 hours, including after hours.',
	},
	{
		question: 'Do I need to sign a long-term contract?',
		answer: 'No. No long-term contract is required.',
	},
];
---

<ServiceLayout
	title={title}
	description={description}
	h1={title}
	eyebrow={city.towns ? city.region : `${city.name}, Texas`}
	intro={`Texas Vending installs, stocks, and services vending machines, micro markets, AI smart coolers, and office coffee for businesses in ${placeList}. Placement is free at locations with at least 50 people in total foot traffic, counting employees and visitors, and no long-term contract is required.`}
	heroImage={hero.image}
	heroAlt={hero.alt}
	serviceType="Vending and breakroom services"
	areaServed={`${placeList}, Texas`}
	crumb={city.towns ? `${city.name} Area` : city.name}
	parent={{ name: 'Cities We Serve', url: '/about-us/cities/' }}
	related={{
		heading: `Cities Near ${city.name}`,
		items: nearbyCities.map((nearby) => ({
			name: nearby.name,
			href: cityHref(nearby),
			summary: `Vending, micro markets, and smart coolers for ${nearby.name} businesses.`,
		})),
	}}
	faqs={faqs}
	cta={{
		heading: `Get Free Vending in ${areaName}`,
		text: 'Book a free site visit. We will look at your space and recommend the right equipment for your team. No long-term contract.',
	}}
>
	<MediaSection image={first.image} alt={first.alt} heading={`Doing Business in ${areaName}`} eyebrow={city.county}>
		{city.about.map((paragraph) => <p>{paragraph}</p>)}
	</MediaSection>

	<MediaSection image={second.image} alt={second.alt} heading={`Where We Serve in ${areaName}`} eyebrow="Local business areas" reverse>
		{
			city.towns && (
				<>
					<h3>Towns in this area</h3>
					<ul>
						{city.towns.map((town) => (
							<li>
								<strong>{town.name}</strong> ({town.county}): {town.note}
							</li>
						))}
					</ul>
					<h3>Business areas</h3>
				</>
			)
		}
		<ul>
			{
				city.businessAreas.map((area) => (
					<li>
						<strong>{area.name}</strong>: {area.note}
					</li>
				))
			}
		</ul>
		<p>Main routes: {city.highways}.</p>
	</MediaSection>

	<PhotoPair
		photos={[
			{ ...pairLeft, caption: 'Cashless payment on every machine: cards, mobile wallets, and tap-to-pay.' },
			{ ...pairRight, caption: 'Fresh food, snacks, and drinks stocked to match what your team buys.' },
		]}
	/>

	<MediaSection image={last.image} alt={last.alt} heading={`Breakroom Services for ${areaName} Workplaces`} eyebrow="What we offer">
		<p>We match equipment to the people, shifts, and space at each site:</p>
		<ul>
			{
				city.focus.map((key) => (
					<li>
						<a href={industryInfo[key].href}>{industryInfo[key].label}</a>: {industryInfo[key].need}
					</li>
				))
			}
		</ul>
		<p>
			We install and run <a href="/our-services/vending-machine/">vending machines</a>, <a href="/our-services/micro-markets/">micro markets</a>, <a href="/our-services/ai-smart-cooler/">AI smart coolers</a>, and <a href="/our-services/coffee-water/">office coffee and water</a>, and we handle <a href="/our-services/vending-repair/">repairs</a> and <a href="/our-services/vending-moving/">moves</a>. We walk your site first, plan visits around your shifts, docks, and badge rules, and respond to reported issues within 24 hours. Comparing providers? Use our <a href="/blog/vending-contract-checklist/">vending contract checklist</a>.
		</p>
	</MediaSection>

	<aside class="mx-auto max-w-6xl px-4 pb-12 text-sm text-slate-500">
		<h2 class="font-mono text-xs tracking-widest uppercase">Sources for local information</h2>
		<ul class="mt-3 flex flex-wrap gap-x-4 gap-y-1">
			{
				city.sources.map((url, i) => (
					<li>
						<a href={url} rel="noopener" class="underline hover:text-brand">
							{sourceLabels[i]}
						</a>
					</li>
				))
			}
		</ul>
	</aside>
</ServiceLayout>
