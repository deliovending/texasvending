---
import { Image } from 'astro:assets';
import { formatDate, getPublishedPosts } from '../lib/blog';
import logo from '../assets/texas-vending-logo-white-footer.png';
import { ADDRESS, BUSINESS_DESCRIPTION, EMAIL, MAIN_MENU, PHONE_DISPLAY, PHONE_TEL, SOCIAL_LINKS } from '../consts';

// Simple brand marks for the social links
const socialIcons: Record<string, string> = {
	Facebook:
		'M22 12a10 10 0 1 0-11.56 9.88v-6.99H7.9V12h2.54V9.8c0-2.5 1.49-3.89 3.78-3.89 1.09 0 2.24.2 2.24.2v2.46h-1.26c-1.24 0-1.63.77-1.63 1.56V12h2.78l-.44 2.89h-2.34v6.99A10 10 0 0 0 22 12Z',
	Instagram:
		'M12 2.16c3.2 0 3.58.01 4.85.07 1.17.05 1.8.25 2.23.41.56.22.96.48 1.38.9.42.42.68.82.9 1.38.16.42.36 1.06.41 2.23.06 1.27.07 1.65.07 4.85s-.01 3.58-.07 4.85c-.05 1.17-.25 1.8-.41 2.23-.22.56-.48.96-.9 1.38-.42.42-.82.68-1.38.9-.42.16-1.06.36-2.23.41-1.27.06-1.65.07-4.85.07s-3.58-.01-4.85-.07c-1.17-.05-1.8-.25-2.23-.41a3.7 3.7 0 0 1-1.38-.9 3.7 3.7 0 0 1-.9-1.38c-.16-.42-.36-1.06-.41-2.23C2.17 15.58 2.16 15.2 2.16 12s.01-3.58.07-4.85c.05-1.17.25-1.8.41-2.23.22-.56.48-.96.9-1.38.42-.42.82-.68 1.38-.9.42-.16 1.06-.36 2.23-.41C8.42 2.17 8.8 2.16 12 2.16ZM12 0C8.74 0 8.33.01 7.05.07 5.78.13 4.9.33 4.14.63c-.79.3-1.46.72-2.13 1.38A5.9 5.9 0 0 0 .63 4.14C.33 4.9.13 5.78.07 7.05.01 8.33 0 8.74 0 12s.01 3.67.07 4.95c.06 1.27.26 2.15.56 2.91.3.79.72 1.46 1.38 2.13a5.9 5.9 0 0 0 2.13 1.38c.76.3 1.64.5 2.91.56C8.33 23.99 8.74 24 12 24s3.67-.01 4.95-.07c1.27-.06 2.15-.26 2.91-.56a5.9 5.9 0 0 0 2.13-1.38 5.9 5.9 0 0 0 1.38-2.13c.3-.76.5-1.64.56-2.91.06-1.28.07-1.69.07-4.95s-.01-3.67-.07-4.95c-.06-1.27-.26-2.15-.56-2.91a5.9 5.9 0 0 0-1.38-2.13A5.9 5.9 0 0 0 19.86.63C19.1.33 18.22.13 16.95.07 15.67.01 15.26 0 12 0Zm0 5.84a6.16 6.16 0 1 0 0 12.32 6.16 6.16 0 0 0 0-12.32ZM12 16a4 4 0 1 1 0-8 4 4 0 0 1 0 8Zm6.4-11.85a1.44 1.44 0 1 0 0 2.88 1.44 1.44 0 0 0 0-2.88Z',
};

const services = MAIN_MENU.find((item) => item.label === 'Our Services')?.children ?? [];

const recentPosts = (await getPublishedPosts()).slice(0, 3);
---

<footer class="bg-ink text-white/70">
	<div class="mx-auto grid max-w-6xl gap-10 px-4 py-16 sm:grid-cols-2 lg:grid-cols-4">
		<div>
			<a href="/" class="inline-block">
				<Image src={logo} alt="Texas Vending home" class="h-16 w-auto" />
			</a>
			<p class="mt-4 text-sm leading-relaxed">{BUSINESS_DESCRIPTION}</p>
			<ul class="mt-5 flex gap-3">
				{
					SOCIAL_LINKS.map((link) => (
						<li>
							<a
								href={link.href}
								rel="noopener me"
								target="_blank"
								aria-label={`Texas Vending on ${link.name}`}
								class="flex h-10 w-10 items-center justify-center rounded-full bg-white/10 text-white transition hover:bg-brand"
							>
								<svg viewBox="0 0 24 24" class="h-5 w-5" fill="currentColor" aria-hidden="true">
									<path d={socialIcons[link.name]} />
								</svg>
							</a>
						</li>
					))
				}
			</ul>
		</div>

		<div>
			<p class="eyebrow !text-white/60">Get in touch</p>
			<address class="mt-4 space-y-2 text-sm not-italic">
				<a href={`tel:${PHONE_TEL}`} class="block hover:text-white">{PHONE_DISPLAY}</a>
				<a href={`mailto:${EMAIL}`} class="block hover:text-white">{EMAIL}</a>
				<span class="block">{ADDRESS.street}<br />{ADDRESS.city}, {ADDRESS.region} {ADDRESS.postalCode}</span>
			</address>
		</div>

		<div>
			<p class="eyebrow !text-white/60">From the blog</p>
			<ul class="mt-4 space-y-3 text-sm">
				{
					recentPosts.map((post) => (
						<li>
							<a href={`/blog/${post.id}/`} class="hover:text-white">{post.data.title}</a>
							<span class="block text-xs text-white/40">
								{formatDate(post.data.pubDate)}
							</span>
						</li>
					))
				}
			</ul>
		</div>

		<nav aria-label="Footer">
			<p class="eyebrow !text-white/60">Our services</p>
			<ul class="mt-4 space-y-2 text-sm">
				{services.map((link) => <li><a href={link.href} class="hover:text-white">{link.label}</a></li>)}
				<li><a href="/contact-us/" class="hover:text-white">Contact Us</a></li>
			</ul>
		</nav>
	</div>
	<div class="border-t border-white/10">
		<p class="mx-auto max-w-6xl px-4 py-6 font-mono text-xs tracking-widest uppercase">
			&copy; {new Date().getFullYear()} Texas Vending · Dallas, Texas
		</p>
	</div>
</footer>
