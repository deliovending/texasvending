---
interface Props {
	faqs: { question: string; answer: string }[];
}

const { faqs } = Astro.props;
---

<section id="faq" class="mx-auto max-w-3xl px-4 py-20 md:py-28">
	<div class="text-center">
		<p class="eyebrow">Questions</p>
		<h2 class="mt-3 text-4xl uppercase md:text-5xl">Frequently Asked Questions</h2>
	</div>
	<div class="mt-12 divide-y divide-slate-200 border-y border-slate-200">
		{
			faqs.map((faq) => (
				<details class="group py-5">
					<summary class="flex cursor-pointer list-none items-center justify-between gap-4">
						<h3 class="text-xl">{faq.question}</h3>
						<span class="font-display text-3xl text-brand transition group-open:rotate-45" aria-hidden="true">+</span>
					</summary>
					<p class="mt-3 text-slate-600">{faq.answer}</p>
				</details>
			))
		}
	</div>
</section>
