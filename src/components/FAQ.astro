---
interface Props {
	faqs: { question: string; answer: string }[];
}

const { faqs } = Astro.props;
---

<section id="faq" class="mx-auto max-w-3xl px-4 py-20 md:py-28">
	<div class="text-center">
		<p class="eyebrow">Questions</p>
		<h2 class="mt-3 text-4xl uppercase md:text-5xl">Frequently Asked Questions</h2>
	</div>
	<!-- Answers stay expanded (no accordion) so every one is visible to readers and search engines -->
	<div class="mt-12 divide-y divide-slate-200 border-y border-slate-200">
		{
			faqs.map((faq) => (
				<div class="py-5">
					<h3 class="text-xl">{faq.question}</h3>
					<p class="mt-2 text-slate-600">{faq.answer}</p>
				</div>
			))
		}
	</div>
</section>
