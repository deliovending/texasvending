---
import { Image } from 'astro:assets';
import breakroomImage from '../assets/home/cafeteria-market-wall.webp';
---

<section class="bg-ink text-white">
	<div class="mx-auto grid max-w-6xl items-center gap-12 px-4 py-20 md:grid-cols-2 md:py-28">
		<div>
			<p class="eyebrow !text-white/60">Local partnership</p>
			<h2 class="mt-3 text-4xl uppercase md:text-5xl">A DFW Team That Shows Up</h2>
			<p class="mt-6 text-lg leading-relaxed text-white/75">
				We are based in Dallas and work North Texas every day. Before we quote, we walk your site
				to see your space, your power, and your traffic. Then we set up the right mix of machines and
				keep it running.
			</p>
			<p class="mt-4 text-lg leading-relaxed text-white/75">
				No long-term contract. No cost for equipment, delivery, or setup at qualifying locations. Just
				a full break room and a local team you can call.
			</p>
			<a href="/contact-us/" class="btn btn-primary mt-8">Book a site visit</a>
		</div>
		<Image
			src={breakroomImage}
			alt="Large employee cafeteria with a full wall of drink coolers, fresh food, and snacks"
			widths={[480, 768, 1000]}
			sizes="(min-width: 768px) 50vw, 100vw"
			class="w-full rounded-soft shadow-2xl"
		/>
	</div>
</section>
