---
import { Image } from 'astro:assets';
import heroImage from '../assets/home/breakroom-market-wall.webp';
import { PHONE_DISPLAY, PHONE_TEL } from '../consts';
---

<!-- Clear photo first (no overlay), with the headline on a navy band just below it -->
<section class="bg-ink text-white">
	<Image
		src={heroImage}
		alt="Break room micro market with drink coolers labeled Indulge, Recharge, and Refresh, a snack wall, and a self-checkout kiosk"
		widths={[640, 1000, 1448]}
		sizes="100vw"
		quality={90}
		loading="eager"
		fetchpriority="high"
		class="h-[72svh] w-full object-cover object-[center_20%]"
	/>
	<div class="mx-auto flex max-w-7xl flex-col gap-8 px-4 py-12 md:flex-row md:items-center md:justify-between md:py-14">
		<div class="max-w-3xl">
			<p class="eyebrow !text-white/70">DFW Vending Services</p>
			<h1 class="mt-3 text-4xl leading-[1.05] uppercase md:text-5xl">
				Free Vending Machine Placement &amp; Service in DFW
			</h1>
			<p class="mt-4 text-lg text-white/90">
				Zero cost placement and service. We install, stock, and care for vending machines, micro
				markets, and coffee service across Dallas–Fort Worth.
			</p>
		</div>
		<div class="flex shrink-0 flex-wrap gap-4">
			<a href="/contact-us/" class="btn btn-primary">Get a Free Machine</a>
			<a href={`tel:${PHONE_TEL}`} class="btn btn-outline">Call {PHONE_DISPLAY}</a>
		</div>
	</div>
</section>
