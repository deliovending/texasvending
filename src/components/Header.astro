---
import { Image } from 'astro:assets';
import logo from '../assets/texas-vending-logo-white.png';
import { EMAIL, MAIN_MENU, PHONE_DISPLAY, PHONE_TEL } from '../consts';
---

<header class="sticky top-0 z-50 bg-ink text-white shadow-lg">
	<div class="hidden border-b border-white/10 sm:block">
		<div class="mx-auto flex max-w-7xl items-center justify-between px-4 py-2 font-mono text-xs tracking-widest text-white/70 uppercase">
			<span>Serving Dallas–Fort Worth · 24/7 support</span>
			<span class="flex gap-6">
				<a href={`tel:${PHONE_TEL}`} class="hover:text-white">{PHONE_DISPLAY}</a>
				<a href={`mailto:${EMAIL}`} class="hover:text-white">{EMAIL}</a>
			</span>
		</div>
	</div>

	<nav class="mx-auto flex max-w-7xl items-center justify-between gap-6 px-4 py-4" aria-label="Main">
		<a href="/" class="shrink-0">
			<Image src={logo} alt="Texas Vending home" class="h-10 w-auto" loading="eager" />
		</a>

		<!-- Desktop menu: dropdowns open on hover and on keyboard focus -->
		<ul class="hidden items-center gap-1 text-sm font-semibold lg:flex">
			{
				MAIN_MENU.map((item) => (
					<li class="group relative">
						<a
							href={item.href}
							class="flex items-center gap-1 rounded px-3 py-2 whitespace-nowrap text-white/85 hover:text-white group-focus-within:text-white group-hover:text-white"
							aria-haspopup={item.children ? 'true' : undefined}
						>
							{item.label}
							{item.children && (
								<svg class="h-4 w-4 transition group-hover:rotate-180" viewBox="0 0 20 20" fill="currentColor" aria-hidden="true">
									<path d="M5.3 7.3a1 1 0 0 1 1.4 0L10 10.6l3.3-3.3a1 1 0 1 1 1.4 1.4l-4 4a1 1 0 0 1-1.4 0l-4-4a1 1 0 0 1 0-1.4Z" />
								</svg>
							)}
						</a>
						{item.children && (
							<ul class="invisible absolute top-full left-0 min-w-60 translate-y-2 overflow-hidden rounded-3xl bg-white py-3 text-ink opacity-0 shadow-xl transition group-focus-within:visible group-focus-within:translate-y-0 group-focus-within:opacity-100 group-hover:visible group-hover:translate-y-0 group-hover:opacity-100">
								{item.children.map((child) => (
									<li>
										<a href={child.href} class="block px-5 py-2 whitespace-nowrap hover:bg-slate-100 hover:text-brand focus:bg-slate-100 focus:text-brand">
											{child.label}
										</a>
									</li>
								))}
							</ul>
						)}
					</li>
				))
			}
			<li class="ml-3"><a href="/contact-us/" class="btn btn-primary !px-5 !py-2.5 !text-xs">Contact Us</a></li>
		</ul>

		<!-- Mobile menu: native <details>, no JavaScript -->
		<details class="group relative lg:hidden">
			<summary class="flex cursor-pointer list-none items-center gap-2 font-mono text-xs tracking-widest uppercase">
				<span>Menu</span>
				<svg class="h-6 w-6" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
					<path class="group-open:hidden" d="M4 7h16M4 12h16M4 17h16" />
					<path class="hidden group-open:block" d="M6 6l12 12M18 6 6 18" />
				</svg>
			</summary>
			<div class="absolute right-0 mt-4 max-h-[80vh] w-72 overflow-y-auto rounded-3xl bg-ink p-5 shadow-xl ring-1 ring-white/10">
				<ul class="space-y-1 text-sm font-semibold">
					{
						MAIN_MENU.map((item) => (
							<li>
								<a href={item.href} class="block py-2 text-white hover:text-white">
									{item.label}
								</a>
								{item.children && (
									<ul class="mb-2 border-l border-white/15 pl-4 font-normal">
										{item.children.map((child) => (
											<li>
												<a href={child.href} class="block py-1.5 text-white/70 hover:text-white">
													{child.label}
												</a>
											</li>
										))}
									</ul>
								)}
							</li>
						))
					}
					<li class="pt-2"><a href="/contact-us/" class="btn btn-primary w-full text-center">Contact Us</a></li>
					<li><a href={`tel:${PHONE_TEL}`} class="block py-2 text-center text-white">Call {PHONE_DISPLAY}</a></li>
				</ul>
			</div>
		</details>
	</nav>
</header>
