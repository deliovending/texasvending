---
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';

interface Props {
	image: ImageMetadata;
	alt: string;
	heading: string;
	eyebrow?: string;
	/** Puts the image on the right on wide screens */
	reverse?: boolean;
	id?: string;
}

const { image, alt, heading, eyebrow, reverse = false, id } = Astro.props;
---

<section id={id} class="mx-auto max-w-6xl px-4 py-12 md:py-16">
	<div class="grid items-center gap-10 md:grid-cols-2 md:gap-14">
		<Image
			src={image}
			alt={alt}
			widths={[480, 768, 1100]}
			sizes="(min-width: 768px) 50vw, 100vw"
			class:list={['aspect-[4/3] w-full rounded-soft object-cover shadow-xl', reverse && 'md:order-last']}
		/>
		<div class="text-lg leading-relaxed text-slate-700 [&_a]:font-semibold [&_a]:text-brand [&_a:hover]:underline [&_h3]:mt-6 [&_h3]:text-2xl [&_h3]:text-slate-900 [&_li]:mt-2 [&_ol]:mt-4 [&_ol]:list-decimal [&_ol]:pl-6 [&_p]:mt-4 [&_ul]:mt-4 [&_ul]:list-disc [&_ul]:pl-6">
			{eyebrow && <p class="eyebrow !mt-0">{eyebrow}</p>}
			<h2 class="mt-3 text-4xl uppercase text-slate-900">{heading}</h2>
			<slot />
		</div>
	</div>
</section>
