---
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';

interface Props {
	photos: { image: ImageMetadata; alt: string; caption: string }[];
}

const { photos } = Astro.props;
---

<!-- Captioned photos side by side -->
<div class="mx-auto max-w-6xl px-4 py-8">
	<ul class="grid gap-8 sm:grid-cols-2">
		{
			photos.map((photo) => (
				<li>
					<figure>
						<Image
							src={photo.image}
							alt={photo.alt}
							widths={[480, 768]}
							sizes="(min-width: 640px) 50vw, 100vw"
							class="aspect-[3/2] w-full rounded-3xl object-cover shadow-lg"
						/>
						<figcaption class="mt-3 text-sm text-slate-600">{photo.caption}</figcaption>
					</figure>
				</li>
			))
		}
	</ul>
</div>
