---
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';

// Photo with an optional caption for use inside blog post prose. Portrait photos keep their shape and center.
interface Props {
	src: ImageMetadata;
	alt: string;
	caption?: string;
}

const { src, alt, caption } = Astro.props;
---

<figure class="not-prose my-10">
	<Image
		src={src}
		alt={alt}
		widths={[480, 768, 1100]}
		sizes="(min-width: 768px) 720px, 100vw"
		class="mx-auto h-auto max-h-[36rem] w-auto max-w-full rounded-soft shadow-lg"
	/>
	{caption && <figcaption class="mt-3 text-center text-sm text-slate-500">{caption}</figcaption>}
</figure>
