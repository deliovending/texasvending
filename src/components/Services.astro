---
import { Image } from 'astro:assets';
import vendingImage from '../assets/services/our-services/snack-drink-vending-machines.jpeg';
import microMarketImage from '../assets/home/services/micro-market-breakroom.webp';
import smartCoolerImage from '../assets/home/services/smart-cooler-24h.webp';
import coffeeImage from '../assets/services/our-services/office-coffee-station.jpg';
import repairImage from '../assets/services/our-services/technician-inspecting-vending-machine.jpg';
import movingImage from '../assets/equipment/moving-wrapped-equipment.webp';

const services = [
	{
		image: vendingImage,
		alt: 'Row of three snack and drink vending machines, fully stocked and lit',
		name: 'Snacks Without the Drive',
		label: 'Vending Machines',
		href: '/our-services/vending-machine/',
		text: 'Snack and drink machines installed, stocked, and serviced at no cost to qualifying locations.',
		cta: 'Stock up',
	},
	{
		image: microMarketImage,
		alt: 'Warehouse break room micro market with drink coolers, snack racks, and a self-checkout kiosk beside picnic tables',
		name: 'A Store in Your Break Room',
		label: 'Micro Markets',
		href: '/our-services/micro-markets/',
		text: 'Self-checkout markets with fresh meals, snacks, and drinks, open around the clock.',
		cta: 'Shop fresh',
	},
	{
		image: smartCoolerImage,
		alt: 'Row of 24-hour smart vending coolers with swipe or tap payment in a break area',
		name: 'Open, Grab, and Go',
		label: 'AI Smart Coolers',
		href: '/our-services/ai-smart-cooler/',
		text: 'Smart coolers that charge automatically when someone takes an item. No lines, no cash.',
		cta: 'Grab one',
	},
	{
		image: coffeeImage,
		alt: 'Coffee station with an espresso machine, mugs, and coffee supplies on a counter',
		name: 'Better Coffee, Every Cup',
		label: 'Coffee & Water',
		href: '/our-services/coffee-water/',
		text: 'Office coffee brewers and filtered water, with supplies delivered on schedule.',
		cta: 'Pour a cup',
	},
	{
		image: repairImage,
		alt: 'Technician kneeling beside a vending machine and writing on a service clipboard',
		name: 'Back Up and Running',
		label: 'Vending Repair',
		href: '/our-services/vending-repair/',
		text: 'Local technicians fix card readers, coolers, and coin mechs, no matter who supplied the machine.',
		cta: 'Fix it',
	},
	{
		image: movingImage,
		alt: 'Mover guiding shrink-wrapped equipment on a pallet through a building entrance',
		name: 'Moved Safely, Set Up Right',
		label: 'Vending Moving',
		href: '/our-services/vending-moving/',
		text: 'We move machines across the building or across town, then level, connect, and test them.',
		cta: 'Move it',
	},
];
---

<section id="services" class="bg-slate-100 py-20 md:py-28">
	<div class="mx-auto max-w-6xl px-4">
		<div class="mx-auto max-w-2xl text-center">
			<p class="eyebrow">What we do</p>
			<h2 class="mt-3 text-4xl uppercase md:text-5xl">Vending and Breakroom Services</h2>
		</div>

		<!-- Phones: compact rows with a thumbnail. From sm up: full photo cards. -->
		<ul class="mt-14 grid gap-4 sm:grid-cols-2 sm:gap-6 lg:grid-cols-3">
			{
				services.map((service) => (
					<li class="flex items-center gap-4 overflow-hidden rounded-soft bg-white p-3 shadow-sm transition hover:-translate-y-1 hover:shadow-lg sm:flex-col sm:items-stretch sm:gap-0 sm:p-0 sm:text-center">
						<Image
							src={service.image}
							alt={service.alt}
							widths={[240, 400, 600, 800]}
							sizes="(min-width: 1024px) 352px, (min-width: 640px) 50vw, 112px"
							class="h-28 w-28 shrink-0 rounded-xl object-cover sm:aspect-[4/3] sm:h-auto sm:w-full sm:rounded-none"
						/>
						<div class="flex flex-1 flex-col items-start sm:items-center sm:p-8">
							<p class="eyebrow !text-[0.7rem] !text-slate-500">{service.label}</p>
							<h3 class="mt-2 text-xl sm:text-2xl">{service.name}</h3>
							<p class="mt-3 hidden flex-1 text-slate-600 sm:block">{service.text}</p>
							<a href={service.href} class="mt-1 font-semibold text-brand hover:underline sm:hidden" aria-label={`${service.cta}: ${service.label}`}>
								{service.cta} →
							</a>
							<a href={service.href} class="btn btn-primary mt-6 hidden sm:inline-block" aria-label={`${service.cta}: ${service.label}`}>
								{service.cta}
							</a>
						</div>
					</li>
				))
			}
		</ul>

		<p class="mt-10 text-center">
			<a href="/our-services/" class="font-semibold text-brand hover:underline">See all services</a>
		</p>
	</div>
</section>
