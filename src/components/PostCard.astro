---
import { Image } from 'astro:assets';
import { formatDate, readingTime, type BlogPost } from '../lib/blog';

interface Props {
	post: BlogPost;
	headingLevel?: 'h2' | 'h3';
}

const { post, headingLevel: Heading = 'h2' } = Astro.props;
const { title, description, pubDate, image, imageAlt, tags } = post.data;
---

<article class="group flex h-full flex-col overflow-hidden rounded-soft bg-white shadow-sm ring-1 ring-slate-200 transition hover:-translate-y-1 hover:shadow-lg">
	<a href={`/blog/${post.id}/`} class="block overflow-hidden" tabindex="-1" aria-hidden="true">
		<Image
			src={image}
			alt={imageAlt}
			widths={[400, 700]}
			sizes="(min-width: 1024px) 33vw, (min-width: 640px) 50vw, 100vw"
			class="aspect-[16/10] w-full object-cover transition duration-500 group-hover:scale-105"
		/>
	</a>
	<div class="flex flex-1 flex-col p-8">
		{tags.length > 0 && <p class="eyebrow !text-[0.7rem]">{tags.slice(0, 2).join(' · ')}</p>}
		<Heading class="mt-2 text-2xl leading-tight">
			<a href={`/blog/${post.id}/`} class="hover:text-brand">{title}</a>
		</Heading>
		<p class="mt-3 flex-1 text-slate-600">{description}</p>
		<p class="mt-6 text-sm text-slate-500">
			<time datetime={pubDate.toISOString()}>{formatDate(pubDate)}</time>
			<span aria-hidden="true"> · </span>{readingTime(post.body)} min read
		</p>
	</div>
</article>
