---
import { PHONE_DISPLAY, PHONE_TEL } from '../consts';

// Call-to-action band for the middle of a page. Works inside prose (blog posts) thanks to "not-prose"; it stacks in narrow columns using a container query.
interface Props {
	heading?: string;
	text?: string;
	buttonLabel?: string;
	href?: string;
}

const {
	heading = 'Ready for a Better Break Room?',
	text = 'Free placement at qualifying sites and no long-term contract. Book a site visit and we will recommend the right setup.',
	buttonLabel = 'Book a Free Site Visit',
	href = '/contact-us/',
} = Astro.props;
---

<aside class="not-prose @container mx-auto my-8 max-w-6xl px-4" aria-label="Contact Texas Vending">
	<div
		class="relative isolate overflow-hidden rounded-soft bg-ink px-8 py-10 text-white shadow-xl @3xl:flex @3xl:items-center @3xl:justify-between @3xl:gap-10 @3xl:px-12"
	>
		<div
			class="absolute inset-0 -z-10 bg-[radial-gradient(ellipse_at_top_right,rgba(188,33,39,0.45),transparent_60%)]"
			aria-hidden="true"
		>
		</div>
		<div class="max-w-xl">
			<p class="font-display text-3xl uppercase">{heading}</p>
			<p class="mt-3 text-white/80">{text}</p>
		</div>
		<div class="mt-6 flex shrink-0 flex-wrap gap-3 @3xl:mt-0">
			<a href={href} class="btn btn-primary">{buttonLabel}</a>
			<a href={`tel:${PHONE_TEL}`} class="btn btn-outline">Call {PHONE_DISPLAY}</a>
		</div>
	</div>
</aside>
