---
import { cityBySlug, cityHref, industryInfo } from '../data/cities';
import { citiesFor, type LiveIndustryUpdate } from '../data/industry-updates';

// "Cities we serve" section for an industry page, shown once its scheduled refresh is live (src/data/industry-updates.ts)
interface Props {
	update: LiveIndustryUpdate;
}

const { update } = Astro.props;
const spotlights = update.spotlights.map(([slug, areaName]) => {
	const city = cityBySlug(slug);
	const area = city?.businessAreas.find((item) => item.name === areaName);
	if (!city || !area) throw new Error(`IndustryCities: no business area "${areaName}" in city "${slug}"`);
	return { city, area };
});
const sentence = (text: string) => text.charAt(0).toUpperCase() + text.slice(1).replace(/\.?$/, '.');
---

<section id="cities" class="py-16 md:py-20">
	<div class="mx-auto max-w-6xl px-4">
		<div class="mx-auto max-w-3xl text-center">
			<p class="eyebrow">Updated <time datetime={update.date}>{update.long}</time></p>
			<h2 class="mt-3 text-4xl uppercase md:text-5xl">{update.label} in Your DFW City</h2>
			<p class="mt-4 text-lg text-slate-600">
				Texas Vending serves {update.audience} across Dallas–Fort Worth and North Texas, where teams need {industryInfo[update.key].need}. The same equipment, 24-hour response, and service planned around your site reach every city below.
			</p>
		</div>
		{
			spotlights.length > 0 && (
				<div class="mt-12 grid gap-6 md:grid-cols-3">
					{spotlights.map(({ city, area }) => (
						<div class="rounded-3xl bg-slate-50 p-6 ring-1 ring-slate-200">
							<p class="font-mono text-xs tracking-widest text-slate-500 uppercase">{city.name}</p>
							<h3 class="mt-1 font-display text-2xl uppercase text-ink">{area.name}</h3>
							<p class="mt-2 text-slate-600">
								{sentence(area.note)}{' '}
								<a href={cityHref(city)} class="font-semibold text-brand hover:underline">
									Vending in {city.name}
								</a>
							</p>
						</div>
					))}
				</div>
			)
		}
		<h3 class="mt-12 text-center font-display text-2xl uppercase text-ink">All Cities We Serve</h3>
		<ul class="mt-6 flex flex-wrap justify-center gap-3">
			{
				citiesFor(update.key).map((city) => (
					<li>
						<a href={cityHref(city)} class="inline-block rounded-full bg-white px-4 py-2 font-semibold text-ink ring-1 ring-slate-200 transition hover:bg-brand hover:text-white">
							{city.name}
						</a>
					</li>
				))
			}
		</ul>
		<p class="mt-8 text-center text-slate-600">
			Don't see your city? We serve all of Dallas–Fort Worth and North Texas. <a href="/contact-us/" class="font-semibold text-brand hover:underline">Ask about your site</a>.
		</p>
	</div>
</section>
