---
// Decorative line icons. Always paired with visible text, so hidden from screen readers.
interface Props {
	name: 'vending' | 'market' | 'cooler' | 'coffee' | 'card' | 'signal' | 'leaf' | 'wrench' | 'truck' | 'clock';
	class?: string;
}

const { name, class: className = 'h-12 w-12' } = Astro.props;
---

<svg
	class={className}
	viewBox="0 0 48 48"
	fill="none"
	stroke="currentColor"
	stroke-width="2.5"
	stroke-linecap="round"
	stroke-linejoin="round"
	aria-hidden="true"
>
	{
		name === 'vending' && (
			<>
				<rect x="10" y="4" width="28" height="40" rx="3" />
				<rect x="14" y="8" width="14" height="24" rx="1" />
				<path d="M14 16h14M14 24h14M32 10v6M32 22h2M16 38h16" />
			</>
		)
	}
	{
		name === 'market' && (
			<>
				<path d="M6 18 10 8h28l4 10" />
				<path d="M6 18c0 3 2.5 5 6 5s6-2 6-5c0 3 2.5 5 6 5s6-2 6-5c0 3 2.5 5 6 5s6-2 6-5" />
				<path d="M9 23v19h30V23M20 42V31h8v11" />
			</>
		)
	}
	{
		name === 'cooler' && (
			<>
				<rect x="10" y="4" width="28" height="40" rx="3" />
				<path d="M10 14h28M33 20v8" />
				<path d="M17 22h6M17 30h6M17 38h6" />
			</>
		)
	}
	{
		name === 'coffee' && (
			<>
				<path d="M8 18h26v12a10 10 0 0 1-10 10h-6A10 10 0 0 1 8 30Z" />
				<path d="M34 21h3a5 5 0 0 1 0 10h-3" />
				<path d="M16 6c-2 3 2 5 0 8M24 6c-2 3 2 5 0 8" />
			</>
		)
	}
	{
		name === 'card' && (
			<>
				<rect x="4" y="11" width="40" height="26" rx="3" />
				<path d="M4 19h40M11 29h8" />
			</>
		)
	}
	{
		name === 'signal' && (
			<>
				<path d="M24 40v-8" />
				<circle cx="24" cy="29" r="3" />
				<path d="M16 21a11 11 0 0 1 16 0M10 15a19 19 0 0 1 28 0" />
			</>
		)
	}
	{
		name === 'leaf' && (
			<>
				<path d="M10 38C8 20 20 8 40 8c0 20-12 32-30 30Z" />
				<path d="M10 38 28 20" />
			</>
		)
	}
	{
		name === 'wrench' && (
			<path d="M30 6a10 10 0 0 0-9 14L6 35a4 4 0 0 0 6 6l15-15a10 10 0 0 0 14-9l-6 6-6-2-2-6Z" />
		)
	}
	{
		name === 'truck' && (
			<>
				<path d="M4 12h24v22H4zM28 20h9l7 7v7H28z" />
				<circle cx="12" cy="36" r="4" />
				<circle cx="36" cy="36" r="4" />
			</>
		)
	}
	{
		name === 'clock' && (
			<>
				<circle cx="24" cy="24" r="18" />
				<path d="M24 14v10l7 5" />
			</>
		)
	}
</svg>
