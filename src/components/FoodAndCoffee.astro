---
import { Image } from 'astro:assets';
import sandwichImage from '../assets/images/sandwich.jpg';
import coffeeImage from '../assets/images/bean-to-cup-coffee.webp';

const items = [
	{
		image: sandwichImage,
		alt: 'Fresh egg, avocado, and greens sandwiches on whole grain bread',
		title: 'Fresh Food',
		text: 'Fresh sandwiches, salads, and ready-to-eat meals, plus protein snacks and better-for-you drinks.',
		href: '/fresh-food/',
		cta: 'See fresh food',
	},
	{
		image: coffeeImage,
		alt: 'Espresso pouring from a coffee machine into a white cup',
		title: 'Coffee & Water',
		text: 'Fresh-brewed coffee and filtered water for your office, with supplies delivered on schedule.',
		href: '/our-services/coffee-water/',
		cta: 'See coffee service',
	},
];
---

<section class="bg-slate-100 py-20 md:py-28">
	<div class="mx-auto max-w-6xl px-4">
		<div class="mx-auto max-w-2xl text-center">
			<p class="eyebrow">Fuel for the workday</p>
			<h2 class="mt-3 text-4xl uppercase md:text-5xl">Fresh Food and Real Coffee</h2>
		</div>
		<ul class="mt-14 grid gap-8 md:grid-cols-2">
			{
				items.map((item) => (
					<li class="overflow-hidden rounded-soft bg-white shadow-sm">
						<Image
							src={item.image}
							alt={item.alt}
							widths={[400, 600]}
							sizes="(min-width: 768px) 50vw, 100vw"
							class="aspect-[4/3] w-full object-cover"
						/>
						<div class="p-10">
							<h3 class="text-3xl">{item.title}</h3>
							<p class="mt-3 text-slate-600">{item.text}</p>
							<a href={item.href} class="btn btn-primary mt-6">{item.cta}</a>
						</div>
					</li>
				))
			}
		</ul>
	</div>
</section>
