---
import { PHONE_DISPLAY, PHONE_TEL } from '../consts';

interface Props {
	heading?: string;
	text?: string;
	buttonLabel?: string;
	/** Call button number. Defaults to the main line. */
	phone?: { display: string; tel: string };
}

const {
	heading = 'Get a Free Vending Machine for Your Business',
	text = 'No installation cost and no long-term contract. Tell us about your location and we will recommend the right setup.',
	buttonLabel = 'Beat the snack attack',
	phone = { display: PHONE_DISPLAY, tel: PHONE_TEL },
} = Astro.props;
---

<section class="px-4 py-16 md:py-20">
	<div class="mx-auto flex max-w-6xl flex-col items-center gap-8 rounded-soft bg-brand px-8 py-14 text-center text-white shadow-xl md:flex-row md:justify-between md:px-14 md:text-left">
		<div class="max-w-2xl">
			<h2 class="text-3xl uppercase md:text-4xl">{heading}</h2>
			<p class="mt-3 text-lg text-white/85">{text}</p>
		</div>
		<div class="flex shrink-0 flex-wrap justify-center gap-4">
			<a href="/contact-us/" class="btn bg-white text-ink hover:bg-slate-100">{buttonLabel}</a>
			<a href={`tel:${phone.tel}`} class="btn btn-outline">Call {phone.display}</a>
		</div>
	</div>
</section>
