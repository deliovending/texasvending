		{ "source": "/best-local-vending-provider-texas{/}?", "destination": "/blog/vending-contract-checklist/", "statusCode": 301 },
		{ "source": "/vending-machine-company-arlington-tx{/}?", "destination": "/blog/vending-contract-checklist/", "statusCode": 301 },
		{ "source": "/vending-machine-cost-arlington-tx{/}?", "destination": "/blog/vending-contract-checklist/", "statusCode": 301 },
		{ "source": "/office-vending-installation-texas-facilities-managers{/}?", "destination": "/blog/vending-contract-checklist/", "statusCode": 301 },
		{ "source": "/office-vending-machine-installation-problems{/}?", "destination": "/blog/vending-contract-checklist/", "statusCode": 301 },

		{ "source": "/the-15-minutes-your-warehouse-didnt-know-it-was-losing{/}?", "destination": "/blog/texas-break-laws-employers/", "statusCode": 301 },
		{ "source": "/smart-cooler-vending-short-lunch-breaks-dfw-warehouses{/}?", "destination": "/blog/texas-break-laws-employers/", "statusCode": 301 },

		{ "source": "/why-warehouses-are-adding-smart-coolers-for-fresh-food{/}?", "destination": "/our-services/ai-smart-cooler/", "statusCode": 301 },
		{ "source": "/how-smart-coolers-boost-sales{/}?", "destination": "/our-services/ai-smart-cooler/", "statusCode": 301 },
		{ "source": "/smart-fridge-placement-dfw-offices-warehouses-campuses{/}?", "destination": "/our-services/ai-smart-cooler/", "statusCode": 301 },
		{ "source": "/dfw-smart-coolers-heat-waves-power-outages{/}?", "destination": "/our-services/ai-smart-cooler/", "statusCode": 301 },
