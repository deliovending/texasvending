		{ "source": "/workplace-outgrown-traditional-vending-employee-demographics{/}?", "destination": "/our-services/micro-markets/", "statusCode": 301 },
		{ "source": "/when-workplace-needs-second-vending-machine-smart-cooler-micro-market{/}?", "destination": "/our-services/micro-markets/", "statusCode": 301 },
		{ "source": "/why-some-micro-markets-fail-after-installation{/}?", "destination": "/our-services/micro-markets/", "statusCode": 301 },
		{ "source": "/micro-market-vs-vending-machine-alliance-tx{/}?", "destination": "/our-services/micro-markets/", "statusCode": 301 },
		{ "source": "/fort-worth-micro-markets{/}?", "destination": "/our-services/micro-markets/", "statusCode": 301 },

		{ "source": "/vending-services-for-drivers-at-alliance-facilities{/}?", "destination": "/alliance-texas-vending-services/", "statusCode": 301 },
		{ "source": "/alliance-warehouse-vending-service-shift-changes{/}?", "destination": "/alliance-texas-vending-services/", "statusCode": 301 },

		{ "source": "/corporate-headquarters-vending-services-plano-tx{/}?", "destination": "/industries-we-serve/corporate-offices/", "statusCode": 301 },
		{ "source": "/how-growing-dallas-offices-can-upgrade-coffee-snacks-and-fresh-food{/}?", "destination": "/our-services/coffee-water/", "statusCode": 301 },
		{ "source": "/cashless-vending-machines-fort-worth-tx{/}?", "destination": "/our-services/vending-machine/", "statusCode": 301 }
	],
	"headers": [
		{
			"source": "/_astro/(.*)",
			"headers": [{ "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }]
		},
		{
			"source": "/(.*)",
			"headers": [
				{ "key": "X-Content-Type-Options", "value": "nosniff" },
				{ "key": "X-Frame-Options", "value": "SAMEORIGIN" },
				{ "key": "Referrer-Policy", "value": "strict-origin-when-cross-origin" },
				{ "key": "Permissions-Policy", "value": "camera=(), microphone=(), geolocation=()" }
			]
		}
	]
}
